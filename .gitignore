# ==========================================
# Git Ignore - SPMB Madrasah Aliyah Project
# ==========================================

# 1. Environment & Sensitive Configs
.env
.env.*
!.env.example
*.env
backend/.env
frontend/.env
backend/.env.*
frontend/.env.*

# 2. Uploads & User Private Documents (Data Pribadi Pendaftar)
uploads/
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
frontend/uploads/*
!frontend/uploads/.gitkeep

# 3. Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# 4. Build & Production Outputs
dist/
dist-ssr/
build/
backend/dist/
frontend/dist/

# 5. Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
backend/logs/

# 6. Scratch & Temporary Files
scratch/
backend/scratch/
frontend/scratch/
*.tmp
*.temp

# 7. IDE & Editor Configs
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 8. OS System Files
.DS_Store
Thumbs.db
desktop.ini
